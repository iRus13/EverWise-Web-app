rules_version = '2';

// Everwise Firestore security rules.
//
// SCOPE OF THIS VERSION: these rules close the data-privacy hole — no user
// can read or write another user's document. They are safe to deploy today
// and will not break the existing purchase flow.
//
// KNOWN REMAINING HOLE (deliberate, documented): a signed-in user can still
// write subscriptionStatus:"active" to their own document and get free
// access. Closing that requires entitlement to be written by trusted server
// code that verifies the App Store receipt (a Firebase Function, or a
// RevenueCat webhook). Until that exists, the app cannot tell a real
// purchase from a forged one. See the commented-out block at the bottom for
// the stricter rules to switch on once it does.
//
// Also note: all lesson content ships inside the public JS bundle, so the
// paywall never protected the course text itself. Only server-rendered or
// server-fetched content can be gated.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // A brand-new account must start unpaid. Cheap to enforce, and it
      // stops the laziest version of the forgery (sign up already "active").
      function createsWithoutEntitlement() {
        return request.resource.data.subscriptionStatus == 'expired'
          && request.resource.data.trialStartedAt == null
          && request.resource.data.plan == null;
      }

      allow get, list: if isOwner();
      allow create: if isOwner() && createsWithoutEntitlement();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // Everything else is closed. Add explicit rules rather than loosening
    // this catch-all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ---------------------------------------------------------------------------
// STRICTER ENTITLEMENT RULES — enable once receipt verification exists.
//
// Replace the `allow update` line above with the version below. It lets the
// client change progress fields and lets it DOWNGRADE itself to "expired"
// (the trial-expiry path in normalizeSubscription), but makes upgrading to
// "trial"/"active" impossible from a device. At that point the purchase flow
// in App.jsx must stop writing entitlement directly and instead wait for the
// server to write it.
//
//   function onlySafeFieldsChanged() {
//     return request.resource.data.diff(resource.data)
//       .affectedKeys()
//       .hasOnly([
//         'name', 'username', 'profileInterview', 'onboardingCompleted',
//         'scamsCaught', 'badges', 'completedLessons'
//       ]);
//   }
//
//   function onlyExpiresEntitlement() {
//     return request.resource.data.diff(resource.data)
//       .affectedKeys()
//       .hasOnly(['subscriptionStatus', 'trialStartedAt', 'plan'])
//       && request.resource.data.subscriptionStatus == 'expired';
//   }
//
//   allow update: if isOwner()
//     && (onlySafeFieldsChanged() || onlyExpiresEntitlement());
// ---------------------------------------------------------------------------
