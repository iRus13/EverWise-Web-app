rules_version = '2';

// Everwise Firestore security rules.
//
// Each learner owns only their users/{uid} document. New accounts start unpaid.
// Existing clients can update subscription mirror fields on their own profile.
// These client-writable fields are NOT authorization: App.jsx resolves access
// from the current user's billing API, native StoreKit, or partner entitlement.
// Keep that separation in any new client or backend reader. The emulator browser
// suite verifies that a forged active profile cannot unlock paid web lessons.
//
// Lesson content currently ships in public assets; the UI paywall does not make
// that content confidential. Protected content requires server-side authorization.
//
// firebase.json explicitly targets the app's named database "default".
// This file alone does not prove which rules are deployed in a live project.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // A brand-new account must start unpaid. Cheap to enforce, and it
      // stops the laziest version of the forgery (sign up already "active").
      function createsWithoutEntitlement() {
        return request.resource.data.subscriptionStatus == 'expired'
          && request.resource.data.trialStartedAt == null
          && request.resource.data.plan == null;
      }

      allow get, list: if isOwner();
      allow create: if isOwner() && createsWithoutEntitlement();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // Everything else is closed. Add explicit rules rather than loosening
    // this catch-all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
